# COSMICARE example environment configuration
# Copy relevant values into backend/.env and frontend/.env as needed. Do not commit real secrets.

# Backend (FastAPI)
APP_ENV=development
# SQLite (default local dev). Use the existing project database path if required.
DATABASE_URL=sqlite:///./cosmicare_rebuild.db
JWT_SECRET=change-me-for-non-development-use
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# LLM settings (optional). Keep mock enabled for offline/local grounded responses.
LLM_PROVIDER=ollama
LLM_MOCK=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=20
SPACE_WEATHER_PROVIDER=noaa_swpc
AI_ESCALATION_ENABLED=true

# Frontend (Vite)
# Set to the backend origin where FastAPI is running (without trailing /api).
VITE_API_BASE_URL=http://127.0.0.1:8001
